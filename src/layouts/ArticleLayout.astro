---
import BaseLayout from './BaseLayout.astro';

interface Props {
  content: {
    title: string;
    description: string;
    publishedDate: string;
    lastVerifiedDate: string;
    category: string;
    tags: string[];
    sources: Array<{
      title: string;
      url: string;
      publisher: string;
      verifiedDate: string;
    }>;
  };
}

const { content } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

// Auto-derive high-level table of contents for the right sidebar
const tableOfContents = [
  { id: 'statutory-framework', title: '1. Statutory Framework & Acts' },
  { id: 'quantitative-mechanics', title: '2. Quantitative Mechanics & Data' },
  { id: 'worked-example', title: '3. Worked Empirical Case Study' },
  { id: 'insolvency-waterfall', title: '4. Insolvency & Resolution Protocol' },
  { id: 'actionable-checklist', title: '5. Institutional Risk Checklist' },
  { id: 'sources-section', title: '6. Official Regulatory Citations' }
];

const statutoryRefs = content.sources ? content.sources.map(s => s.title) : [];
---

<BaseLayout
  title={content.title}
  description={content.description}
  category={content.category}
  verifiedOn={content.lastVerifiedDate}
  lastUpdated={content.publishedDate}
  statutoryReferences={statutoryRefs}
  tableOfContents={tableOfContents}
  showSidebars={true}
>
  <div class="article-page-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`${basePath}/`}>Home</a> &gt; 
      <a href={`${basePath}/articles/`}>Research Library</a> &gt; 
      <span>{content.category}</span>
    </nav>

    <div class="meta-badges">
      <span class="badge badge-gold">{content.category}</span>
      <span class="badge badge-blue">Statutory Rigor: Verified {content.lastVerifiedDate}</span>
    </div>

    <h1 class="article-title">{content.title}</h1>
    <p class="article-subtitle">{content.description}</p>

    <div class="article-meta-bar">
      <span>Published: {content.publishedDate}</span>
      <span>•</span>
      <span>InvestiQ Banking Quantitative Research Team</span>
      <span>•</span>
      <a href={`${basePath}/corrections/`} class="report-link">Report an Error</a>
    </div>

    <div class="callout-box info" style="margin-top: 1.5rem; margin-bottom: 0;">
      <div class="callout-title">Institutional Banking Rigor Standard</div>
      <p style="margin: 0; font-size: 0.95rem;">
        Every threshold, timeline, set-off formula, and legal doctrine in this treatise has been verified against the current Gazette of India, RBI Master Directions, and Supreme Court constitutional precedents.
      </p>
    </div>
  </div>

  <article class="prose">
    <slot />
  </article>

  {content.sources && content.sources.length > 0 && (
    <section id="sources-section" class="sources-section">
      <h3>Primary Regulatory & Statutory Sources</h3>
      <p class="sources-desc">Direct statutory references verified against central bank gazettes and apex court rulings:</p>
      <ul class="sources-list">
        {content.sources.map(src => (
          <li>
            <a href={src.url} target="_blank" rel="noopener noreferrer" class="source-link">
              <strong>{src.title}</strong>
            </a>
            <span class="source-meta"> — {src.publisher} (Verified: {src.verifiedDate})</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="callout-box alert">
    <div class="callout-title">Statutory Legal & Insolvency Notice</div>
    <p style="margin: 0; font-size: 0.9rem;">
      Mathematical models, bank categorization matrices, and deposit insurance simulations do not constitute individual legal, tax, or banking advice. Insolvency resolution processes are subject to the discretion of the Reserve Bank of India under the Banking Regulation Act, 1949 and DICGC Act, 1961. Always consult qualified legal counsel or a Chartered Accountant.
    </p>
  </div>

  <div class="article-footer-nav">
    <a href={`${basePath}/articles/`} class="btn">← Back to Research Library</a>
    <a href={`${basePath}/calculators/`} class="btn btn-gold">Explore Interactive Solvers →</a>
  </div>
</BaseLayout>

<style>
  .article-page-header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--iq-border);
    padding-bottom: 1.5rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--iq-text-muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    color: var(--iq-text-secondary);
  }

  .meta-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-size: 2.35rem;
    line-height: 1.22;
    margin-bottom: 1rem;
    color: var(--iq-text-primary);
    letter-spacing: -0.02em;
  }

  .article-subtitle {
    font-size: 1.15rem;
    color: var(--iq-text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .article-meta-bar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.825rem;
    color: var(--iq-text-muted);
    flex-wrap: wrap;
  }

  .report-link {
    color: var(--iq-accent);
    text-decoration: underline;
  }

  .sources-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--iq-border);
  }

  .sources-desc {
    font-size: 0.9rem;
    color: var(--iq-text-secondary);
    margin-bottom: 1rem;
  }

  .sources-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
  }

  .sources-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--iq-border-subtle);
    font-size: 0.9rem;
  }

  .source-link {
    color: var(--iq-accent);
  }

  .source-meta {
    color: var(--iq-text-muted);
    font-size: 0.85rem;
  }

  .article-footer-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--iq-border);
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
