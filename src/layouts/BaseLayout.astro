---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  category?: string;
  verifiedOn?: string;
  lastUpdated?: string;
  statutoryReferences?: string[];
  tableOfContents?: { id: string; title: string }[];
  showSidebars?: boolean;
}

const {
  title,
  description,
  canonicalUrl = 'https://chirag127.github.io/investiq-vault-banking/',
  category,
  verifiedOn = '2026-10-17',
  lastUpdated = '2026-10-17',
  statutoryReferences = [],
  tableOfContents = [],
  showSidebars = true
} = Astro.props;

const currentPath = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | InvestiQ VaultBanking</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | InvestiQ VaultBanking`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="InvestiQ VaultBanking" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | InvestiQ VaultBanking`} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- KaTeX CSS for LaTeX Mathematical Rendering -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
      integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaigo2TQ4nmhZltCSFX-QDAmlnTuqv6520GFCZJ"
      crossorigin="anonymous"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
      integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk"
      crossorigin="anonymous"
      onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});"
    ></script>

    <!-- Mermaid.js for Diagrams -->
    <script type="module" is:inline>
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
      mermaid.initialize({
        startOnLoad: true,
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#101622',
          primaryColor: '#388bfd',
          primaryTextColor: '#f0f6fc',
          primaryBorderColor: '#232d42',
          lineColor: '#e3b341',
          secondaryColor: '#182030',
          tertiaryColor: '#090d14'
        }
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to primary content</a>

    <!-- Top Institutional Header -->
    <header class="site-header">
      <div class="header-inner">
        <a href={`${basePath}/`} class="brand-wrapper">
          <span class="brand-badge">04 of 60</span>
          <span class="brand-title">
            VaultBanking <span class="brand-network">| InvestiQ India</span>
          </span>
        </a>

        <nav aria-label="Main Navigation">
          <ul class="nav-links">
            <li><a href={`${basePath}/`} class={`nav-link ${currentPath === `${basePath}/` || currentPath === basePath ? 'active' : ''}`}>Overview</a></li>
            <li><a href={`${basePath}/articles/`} class={`nav-link ${currentPath.includes('/articles') ? 'active' : ''}`}>Research Library</a></li>
            <li><a href={`${basePath}/calculators/`} class={`nav-link ${currentPath.includes('/calculators') ? 'active' : ''}`}>Banking Solvers</a></li>
            <li><a href={`${basePath}/sources/`} class={`nav-link ${currentPath.includes('/sources') ? 'active' : ''}`}>Statutory Sources</a></li>
            <li><a href={`${basePath}/faq/`} class={`nav-link ${currentPath.includes('/faq') ? 'active' : ''}`}>FAQ</a></li>
            <li><a href={`${basePath}/glossary/`} class={`nav-link ${currentPath.includes('/glossary') ? 'active' : ''}`}>Glossary</a></li>
          </ul>
        </nav>

        <div class="header-actions">
          <button id="search-open-btn" class="search-trigger-btn" aria-label="Open Search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Search</span>
          </button>
          <button id="theme-toggle-btn" class="theme-toggle-btn" aria-label="Toggle Dark/Light Mode">
            <span id="theme-icon">🌓</span>
          </button>
        </div>
      </div>
    </header>

    <!-- 3-Column Master Grid Layout Container -->
    <div class={`layout-container ${!showSidebars ? 'full-width' : tableOfContents.length === 0 ? 'two-column' : ''}`}>
      {showSidebars && (
        <aside class="left-sidebar" aria-label="Banking Solvers & Categories">
          <div class="sidebar-section">
            <h2 class="sidebar-title">Interactive Solvers</h2>
            <ul class="sidebar-menu">
              <li><a href={`${basePath}/calculators/#dicgc-audit`}>DICGC Insurance Aggregation Audit</a></li>
              <li><a href={`${basePath}/calculators/#auto-sweep-optimizer`}>Auto-Sweep Yield & Breakage Optimizer</a></li>
              <li><a href={`${basePath}/calculators/#cash-tiering-planner`}>Operating Cash Tiering Planner</a></li>
            </ul>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Research Categories</h2>
            <ul class="sidebar-menu">
              <li><a href={`${basePath}/articles/`}>Institutional Bank Architecture</a></li>
              <li><a href={`${basePath}/articles/`}>DICGC Deposit Insurance</a></li>
              <li><a href={`${basePath}/articles/`}>Auto-Sweep & Cash Mechanics</a></li>
              <li><a href={`${basePath}/articles/`}>Cooperative vs Commercial Banks</a></li>
              <li><a href={`${basePath}/articles/`}>Account Operations & Fraud Defense</a></li>
            </ul>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Primary Statutory Acts</h2>
            <ul class="sidebar-menu">
              <li><a href={`${basePath}/articles/dicgc-statutory-limits-aggregation-rules/`}>DICGC Act 1961 (Sec 16 & 17)</a></li>
              <li><a href={`${basePath}/articles/dicgc-2021-amendment-section-18a-moratorium/`}>Section 18A (90-Day Payout)</a></li>
              <li><a href={`${basePath}/articles/d-sib-framework-too-big-to-fail-banks/`}>RBI D-SIB Framework (CET1)</a></li>
              <li><a href={`${basePath}/articles/tax-drag-80tta-vs-80ttb-auto-sweep/`}>Income Tax Sec 80TTA / 80TTB</a></li>
              <li><a href={`${basePath}/articles/unauthorized-electronic-banking-transactions-rbi-charter/`}>RBI Zero-Liability Charter</a></li>
            </ul>
          </div>
        </aside>
      )}

      <!-- Central Main Content Area -->
      <main id="main-content" class="main-content">
        <slot />
      </main>

      {showSidebars && tableOfContents.length > 0 && (
        <aside class="right-sidebar" aria-label="Table of Contents & Statutory Rigor">
          <div class="card-widget">
            <div class="widget-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              <span>On This Page</span>
            </div>
            <ul class="toc-list">
              {tableOfContents.map((item) => (
                <li><a href={`#${item.id}`}>{item.title}</a></li>
              ))}
            </ul>
          </div>

          <div class="card-widget">
            <div class="widget-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>Statutory Rigor</span>
            </div>
            <div style="font-size: 0.825rem; color: var(--iq-text-secondary); line-height: 1.5;">
              <p><strong>Verified On:</strong> {verifiedOn}</p>
              <p><strong>Last Updated:</strong> {lastUpdated}</p>
              {statutoryReferences.length > 0 && (
                <div style="margin-top: 0.5rem;">
                  <strong style="color: var(--iq-text-muted); font-size: 0.75rem; text-transform: uppercase;">Key Acts / Rules:</strong>
                  <ul style="padding-left: 1rem; margin-top: 0.25rem;">
                    {statutoryReferences.map((ref) => (
                      <li style="font-size: 0.775rem;">{ref}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>

          <div class="card-widget">
            <div class="widget-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
              <span>Institutional Notice</span>
            </div>
            <p style="font-size: 0.775rem; color: var(--iq-text-muted); line-height: 1.45;">
              VaultBanking is an educational, non-commercial public research initiative. Calculations and legal outlines do not constitute formal legal counsel.
            </p>
          </div>
        </aside>
      )}
    </div>

    <!-- Search Modal -->
    <div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="Site Search">
      <div class="search-box">
        <div class="search-input-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="site-search-input" class="search-input" placeholder="Search DICGC rules, Section 18A, Auto-Sweep, D-SIB, tools..." autocomplete="off" />
          <button id="search-close-btn" class="btn btn-secondary btn-sm" aria-label="Close Search">Esc</button>
        </div>
        <div id="search-results-list" class="search-results">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>

    <!-- Institutional Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${basePath}/`} class="brand-title">
            VaultBanking <span class="brand-network">| InvestiQ India</span>
          </a>
          <p>
            Public institutional research portal dedicated to empirical Indian bank architecture, systemic D-SIB risk, DICGC statutory deposit insurance aggregation, flexi-sweep optimization, and treasury cash tiering.
          </p>
          <div style="font-size: 0.8rem; color: var(--iq-success);">
            🔒 100% Client-Side • Zero Trackers • Zero Telemetry • No Data Storage
          </div>
        </div>

        <div>
          <h2 class="footer-col-title">Calculators & Tools</h2>
          <ul class="footer-links">
            <li><a href={`${basePath}/calculators/#dicgc-audit`}>DICGC Insurance Aggregation Audit</a></li>
            <li><a href={`${basePath}/calculators/#auto-sweep-optimizer`}>Auto-Sweep vs Savings Yield Optimizer</a></li>
            <li><a href={`${basePath}/calculators/#cash-tiering-planner`}>Operating Cash Tiering Planner</a></li>
            <li><a href={`${basePath}/methodology/`}>Calculation Methodologies</a></li>
          </ul>
        </div>

        <div>
          <h2 class="footer-col-title">Statutory Treatises</h2>
          <ul class="footer-links">
            <li><a href={`${basePath}/articles/dicgc-statutory-limits-aggregation-rules/`}>DICGC ₹5 Lakh Limit & Aggregation</a></li>
            <li><a href={`${basePath}/articles/dicgc-2021-amendment-section-18a-moratorium/`}>Section 18A 90-Day Payout Rule</a></li>
            <li><a href={`${basePath}/articles/d-sib-framework-too-big-to-fail-banks/`}>RBI D-SIB Capital Surcharges</a></li>
            <li><a href={`${basePath}/articles/tax-drag-80tta-vs-80ttb-auto-sweep/`}>Section 80TTA vs 80TTB Tax Drag</a></li>
            <li><a href={`${basePath}/sources/`}>Primary Statutory Sources</a></li>
          </ul>
        </div>

        <div>
          <h2 class="footer-col-title">Editorial & Governance</h2>
          <ul class="footer-links">
            <li><a href={`${basePath}/disclaimer/`}>Educational Disclaimer</a></li>
            <li><a href={`${basePath}/privacy/`}>Zero-Telemetry Privacy Policy</a></li>
            <li><a href={`${basePath}/corrections/`}>Report an Error / Corrections</a></li>
            <li><a href={`${basePath}/faq/`}>Statutory FAQ</a></li>
            <li><a href={`${basePath}/glossary/`}>Banking Glossary</a></li>
            <li><a href="https://github.com/chirag127/investiq-vault-banking" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div>
          © 2026 InvestiQ India. Open-source educational financial initiative. Site 04 of 60.
        </div>
        <div>
          Built with Astro static output. Hosted on GitHub Pages with strict zero-tracking compliance.
        </div>
      </div>
    </footer>

    <!-- Global Client-Side Scripts -->
    <script is:inline>
      // 1. Theme Toggle
      const themeBtn = document.getElementById('theme-toggle-btn');
      const themeIcon = document.getElementById('theme-icon');
      const currentTheme = localStorage.getItem('iq_theme') || 'dark';

      document.documentElement.setAttribute('data-theme', currentTheme);
      if (themeIcon) {
        themeIcon.textContent = currentTheme === 'light' ? '☀️' : '🌓';
      }

      themeBtn?.addEventListener('click', () => {
        const nextTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('iq_theme', nextTheme);
        if (themeIcon) {
          themeIcon.textContent = nextTheme === 'light' ? '☀️' : '🌓';
        }
      });

      // 2. Client-Side Instant Search Index
      const searchModal = document.getElementById('search-modal');
      const searchOpenBtn = document.getElementById('search-open-btn');
      const searchCloseBtn = document.getElementById('search-close-btn');
      const searchInput = document.getElementById('site-search-input');
      const searchResultsList = document.getElementById('search-results-list');

      const SEARCH_INDEX = [
        { title: 'DICGC Deposit Insurance Aggregation Audit', url: '/investiq-vault-banking/calculators/#dicgc-audit', category: 'Tool', snippet: 'Model multi-bank, multi-branch, and multi-capacity deposit holdings under DICGC ₹5 Lakh limit and set-off rules.' },
        { title: 'Auto-Sweep versus Savings Yield Optimizer', url: '/investiq-vault-banking/calculators/#auto-sweep-optimizer', category: 'Tool', snippet: 'Quantify real post-tax net alpha of flexi-deposits factoring in LIFO breakage penalties and Section 80TTA vs 80TTB tax drag.' },
        { title: 'Operating Cash Tiering & Diversification Planner', url: '/investiq-vault-banking/calculators/#cash-tiering-planner', category: 'Tool', snippet: 'Architect personal and corporate cash into 3 liquidity tiers and safe multi-bank DICGC allocations.' },
        { title: 'Indian Banking Architecture: Scheduled Commercial vs Cooperative vs SFBs', url: '/investiq-vault-banking/articles/indian-banking-architecture-scheduled-vs-cooperative/', category: 'Treatise', snippet: 'Regulatory tiers, prudential capital mandates, and statutory differences between SCBs, UCBs, and SFBs.' },
        { title: 'DICGC Deposit Insurance: Statutory Limits, Aggregation & Branch Rules', url: '/investiq-vault-banking/articles/dicgc-statutory-limits-aggregation-rules/', category: 'Treatise', snippet: '₹5,00,000 statutory limit, all-branch aggregation rules, accrued interest inclusion, and set-off liabilities.' },
        { title: 'The Same Right and Same Capacity Legal Doctrine in Deposit Insurance', url: '/investiq-vault-banking/articles/same-right-same-capacity-legal-doctrine/', category: 'Treatise', snippet: 'Forensic analysis of how personal, joint, sole proprietorship, trust, and minor accounts create independent ₹5 Lakh covers.' },
        { title: 'Section 18A and the 90-Day Payout Rule Under Bank Moratorium', url: '/investiq-vault-banking/articles/dicgc-2021-amendment-section-18a-moratorium/', category: 'Treatise', snippet: 'Statutory 90-day interim payout timeline under Section 18A when RBI imposes All-Inclusive Directions.' },
        { title: 'RBI D-SIB Framework: Capital Surcharges for SBI, HDFC Bank & ICICI Bank', url: '/investiq-vault-banking/articles/d-sib-framework-too-big-to-fail-banks/', category: 'Treatise', snippet: 'Domestic Systemically Important Banks, systemic importance scores, and why these institutions are Too Big to Fail.' },
        { title: 'Auto-Sweep Deposits: Thresholds, Breakage Penalties & LIFO Liquidation', url: '/investiq-vault-banking/articles/auto-sweep-accounts-breakage-penalties/', category: 'Treatise', snippet: 'Mathematical breakdown of flexi-deposits: thresholds, step units, premature penalties, and LIFO liquidation.' },
        { title: 'Tax Drag on Sweep Deposits: Section 80TTA vs 80TTB vs FD Marginal Slab', url: '/investiq-vault-banking/articles/tax-drag-80tta-vs-80ttb-auto-sweep/', category: 'Treatise', snippet: 'Forensic tax analysis: loss of Section 80TTA savings exemptions and Section 194A TDS thresholds.' },
        { title: 'Three-Tier Operating Cash Architecture for Corporate and Retail Treasuries', url: '/investiq-vault-banking/articles/institutional-operating-cash-tiering/', category: 'Treatise', snippet: 'Segregating operating cash into Intraday Clearing, Working Capital Buffers, and Strategic Contingency Reserves.' },
        { title: 'Bank Nomination Rules: Form DA-1, Nominee Rights vs Legal Heirs', url: '/investiq-vault-banking/articles/bank-nomination-rules-legal-heir-rights/', category: 'Treatise', snippet: 'Section 45ZA of the Banking Regulation Act: why a nominee is merely a fiduciary trustee for legal heirs.' },
        { title: 'Unauthorized Electronic Banking Transactions: Zero-Liability Rules', url: '/investiq-vault-banking/articles/unauthorized-electronic-banking-transactions-rbi-charter/', category: 'Treatise', snippet: 'RBI Customer Protection Charter: 3-day reporting zero liability, 10-day shadow credit, and burden of proof.' },
        { title: 'Inoperative Accounts, 10-Year Dormancy & The RBI UDGAM Portal', url: '/investiq-vault-banking/articles/inoperative-dormant-accounts-unclaimed-deposits-udgam/', category: 'Treatise', snippet: 'Dormant account rules, transfers to RBI DEA Fund, and search via the UDGAM portal.' },
        { title: 'RBI Integrated Ombudsman Scheme: 30-Day Resolution Protocol', url: '/investiq-vault-banking/articles/rbi-integrated-ombudsman-scheme-escalation/', category: 'Treatise', snippet: 'Reserve Bank Integrated Ombudsman Scheme (RB-IOS 2021) and CMS escalations for up to ₹20 Lakhs compensation.' },
        { title: 'Right of Set-Off and Depositor Priority Waterfall in Bank Resolution', url: '/investiq-vault-banking/articles/set-off-rules-and-insolvency-priority-waterfall/', category: 'Treatise', snippet: 'Banker Lien under Section 171 Contract Act and depositor recovery waterfall in liquidation.' }
      ];

      function openSearch() {
        if (!searchModal) return;
        searchModal.classList.add('active');
        searchInput?.focus();
        renderSearchResults('');
      }

      function closeSearch() {
        if (!searchModal) return;
        searchModal.classList.remove('active');
        if (searchInput) searchInput.value = '';
      }

      function renderSearchResults(query) {
        if (!searchResultsList) return;
        const q = query.toLowerCase().trim();
        const filtered = q === '' 
          ? SEARCH_INDEX.slice(0, 5) 
          : SEARCH_INDEX.filter(item => 
              item.title.toLowerCase().includes(q) || 
              item.snippet.toLowerCase().includes(q) ||
              item.category.toLowerCase().includes(q)
            );

        if (filtered.length === 0) {
          searchResultsList.innerHTML = `<div style="padding: 1.5rem; text-align: center; color: var(--iq-text-muted); font-size: 0.9rem;">No matching banking treatises or solvers found for "${query}".</div>`;
          return;
        }

        searchResultsList.innerHTML = filtered.map(item => `
          <a href="${item.url}" class="search-result-item">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <span class="search-result-title">${item.title}</span>
              <span style="font-size: 0.7rem; background: var(--iq-surface-raised); padding: 0.15rem 0.4rem; border-radius: 4px; color: var(--iq-accent); font-weight: 600;">${item.category}</span>
            </div>
            <div class="search-result-snippet">${item.snippet}</div>
          </a>
        `).join('');
      }

      searchOpenBtn?.addEventListener('click', openSearch);
      searchCloseBtn?.addEventListener('click', closeSearch);

      searchModal?.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearch();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape' && searchModal?.classList.contains('active')) {
          closeSearch();
        }
      });

      searchInput?.addEventListener('input', (e) => {
        renderSearchResults(e.target.value);
      });
    </script>
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -999px;
    left: 1rem;
    background: var(--iq-accent);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: var(--iq-radius-md);
    z-index: 9999;
    text-decoration: none;
    font-weight: 600;
  }
  .skip-to-content:focus {
    top: 1rem;
  }

  /* Header Styles */
  .site-header {
    background-color: var(--iq-surface);
    border-bottom: 1px solid var(--iq-border);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
  }

  .header-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-badge {
    background: var(--iq-rupee-gold-glow);
    border: 1px solid var(--iq-rupee-gold);
    color: var(--iq-rupee-gold);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.45rem;
    border-radius: var(--iq-radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--iq-text-primary);
  }

