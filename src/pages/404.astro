---
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="404 — Document Not Found"
  description="The requested banking treatise, calculator, or statutory reference could not be located."
>
  <div class="container container-narrow not-found-page">
    <div class="card not-found-card">
      <span class="badge badge-danger">ERROR 404</span>
      <h1 class="not-found-title">Document Not Found</h1>
      <p class="not-found-desc">
        The requested URL does not match any current treatise, financial solver, or statutory gazette in the VaultBanking repository.
      </p>

      <div class="not-found-actions">
        <a href={`${basePath}/`} class="btn btn-primary">Return to Overview</a>
        <a href={`${basePath}/articles/`} class="btn">Browse 15+ Research Treatises</a>
        <a href={`${basePath}/calculators/`} class="btn btn-gold">Open Banking Solvers</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding: 4rem 0;
    text-align: center;
  }

  .not-found-card {
    padding: 3rem 2rem;
    max-width: 600px;
    margin: 0 auto;
    background: var(--iq-surface);
  }

  .not-found-title {
    font-size: 2.5rem;
    margin: 1rem 0 0.5rem 0;
  }

  .not-found-desc {
    color: var(--iq-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
